<?xml version="1.0" encoding="utf-8"?>
<!-- IPTV providers are routinely plain HTTP, and the app's own server is
     http://127.0.0.1, so cleartext has to stay allowed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
